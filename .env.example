# ---- AI endpoint (any OpenAI-compatible /chat/completions API) ----
AI_API_KEY=replace-me
AI_BASE_URL=https://your-endpoint.example.com/v1
AI_MODEL_NAME=your-model-name
AI_TIMEOUT_SECONDS=30

# true = deterministic offline draft, no API call (safe default for demos/tests)
USE_MOCK_LLM=true

# ---- Sidecar persistence ----
SQLITE_PATH=/data/clearpath_state.db

# ---- Odoo JSON-RPC (sidecar -> Odoo callback) ----
ODOO_URL=http://odoo:8069
ODOO_DB=clearpath
ODOO_USER=admin
ODOO_PASSWORD=admin

# ---- Optional: voice transcription (Whisper-style /audio/transcriptions) ----
# Leave blank to use the built-in demo transcript.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL_NAME=
# NVIDIA hosted Riva (Parakeet) over gRPC; reuses ASR_API_KEY. WAV audio only.
ASR_RIVA_SERVER=grpc.nvcf.nvidia.com:443
ASR_RIVA_FUNCTION_ID=
ASR_LANGUAGE_CODE=en-US

# ---- Optional: nurse supply-sheet photo scan (vision chat/completions) ----
# Leave blank to use the built-in demo supply counts.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=
