# ---- AI endpoint (any OpenAI-compatible /chat/completions API) ----
AI_API_KEY=replace-me
AI_BASE_URL=https://your-endpoint.example.com/v1
AI_MODEL_NAME=your-model-name
AI_TIMEOUT_SECONDS=30

# true = deterministic offline draft, no API call (safe default for demos/tests)
USE_MOCK_LLM=true

# ---- Sidecar persistence ----
SQLITE_PATH=/data/clearpath_state.db

# ---- Odoo JSON-RPC (sidecar -> Odoo callback) ----
ODOO_URL=http://odoo:8069
ODOO_DB=clearpath
ODOO_USER=admin
ODOO_PASSWORD=admin

# ---- Optional: voice transcription (Whisper-style /audio/transcriptions) ----
# Leave blank to use the built-in demo transcript.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL_NAME=
# NVIDIA hosted Riva (Parakeet) over gRPC; reuses ASR_API_KEY. WAV audio only.
ASR_RIVA_SERVER=grpc.nvcf.nvidia.com:443
ASR_RIVA_FUNCTION_ID=
ASR_LANGUAGE_CODE=en-US

# ---- Optional: nurse supply-sheet photo scan (vision chat/completions) ----
# Leave blank to use the built-in demo supply counts.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL_NAME=

# ---- Patient SMS + live discharge tracker (Twilio) ----
# USE_MOCK_SMS=true (or blank Twilio credentials): the SMS text and tracker link are logged and shown in
# the Odoo chatter instead of being sent, so the demo never depends on cellular delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Fallback recipient when the patient record has no mobile number (E.164 format).
PATIENT_DEMO_PHONE=+971500000000
# Base URL of the link inside the SMS. localhost only opens on this machine: for a real phone use the
# machine's LAN address or a tunnel URL.
PUBLIC_ODOO_BASE_URL=http://localhost:8069
USE_MOCK_SMS=true
