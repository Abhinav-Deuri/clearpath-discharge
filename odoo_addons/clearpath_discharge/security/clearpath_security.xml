<odoo>
    <record id="res_groups_privilege_clearpath" model="res.groups.privilege">
        <field name="name">ClearPath Discharge</field>
        <field name="sequence">80</field>
    </record>

    <record id="group_clearpath_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_clearpath_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_clearpath_billing" model="res.groups">
        <field name="name">Billing Officer</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_clearpath_coordinator" model="res.groups">
        <field name="name">Discharge Coordinator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_clearpath_nurse" model="res.groups">
        <field name="name">Nurse - Bedside Supply Upload</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_clearpath_admin" model="res.groups">
        <field name="name">Hospital Admin / Insurance Officer</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_clearpath"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
