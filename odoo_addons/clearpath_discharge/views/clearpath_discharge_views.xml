<odoo>
    <record id="clearpath_discharge_action" model="ir.actions.act_window">
        <field name="name">Discharges</field>
        <field name="res_model">clearpath.discharge</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Role queues: the same dashboard, opened on the cards waiting for one department. -->
    <record id="clearpath_discharge_action_pharmacy_queue" model="ir.actions.act_window">
        <field name="name">Pharmacy Queue</field>
        <field name="res_model">clearpath.discharge</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_queue_pharmacy': 1}</field>
    </record>
    <record id="clearpath_discharge_action_billing_queue" model="ir.actions.act_window">
        <field name="name">Billing Queue</field>
        <field name="res_model">clearpath.discharge</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_queue_billing': 1}</field>
    </record>
    <record id="clearpath_discharge_action_insurance_queue" model="ir.actions.act_window">
        <field name="name">Insurance Queue</field>
        <field name="res_model">clearpath.discharge</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_queue_insurance': 1}</field>
    </record>

    <record id="clearpath_discharge_view_list" model="ir.ui.view">
        <field name="name">clearpath.discharge.list</field>
        <field name="model">clearpath.discharge</field>
        <field name="arch" type="xml">
            <list string="Discharges"
                  decoration-danger="state == 'flagged'"
                  decoration-success="state in ('cleared', 'released')"
                  decoration-muted="state == 'draft'">
                <field name="patient_code"/>
                <field name="patient_id"/>
                <field name="bed_number"/>
                <field name="revision_id" string="Rev"/>
                <field name="pharmacy_status" widget="badge"
                       decoration-danger="pharmacy_status == 'flagged'"
                       decoration-success="pharmacy_status == 'approved'"
                       decoration-warning="pharmacy_status == 'stale'"/>
                <field name="billing_status" widget="badge"
                       decoration-danger="billing_status == 'flagged'"
                       decoration-success="billing_status == 'approved'"
                       decoration-warning="billing_status == 'stale'"/>
                <field name="insurance_status" widget="badge"
                       decoration-danger="insurance_status == 'flagged'"
                       decoration-success="insurance_status == 'approved'"
                       decoration-warning="insurance_status == 'stale'"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'flagged'"
                       decoration-success="state in ('cleared', 'released')"
                       decoration-info="state in ('locked', 'verifying')"/>
            </list>
        </field>
    </record>

    <record id="clearpath_discharge_view_search" model="ir.ui.view">
        <field name="name">clearpath.discharge.search</field>
        <field name="model">clearpath.discharge</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="patient_code"/>
                <filter name="filter_flagged" string="Flagged" domain="[('state', '=', 'flagged')]"/>
                <filter name="filter_awaiting" string="Awaiting Sign-off"
                        domain="[('state', 'in', ('verifying', 'flagged'))]"/>
                <filter name="filter_released" string="Released" domain="[('state', '=', 'released')]"/>
                <separator/>
                <filter name="queue_pharmacy" string="Pharmacy Queue" groups="clearpath_discharge.group_clearpath_pharmacist,base.group_system"
                        domain="[('state', 'in', ('flagged', 'verifying')), ('pharmacy_status', 'in', ('pending', 'flagged'))]"/>
                <filter name="queue_billing" string="Billing Queue" groups="clearpath_discharge.group_clearpath_billing,base.group_system"
                        domain="[('state', 'in', ('flagged', 'verifying')), ('billing_status', 'in', ('pending', 'flagged'))]"/>
                <filter name="queue_insurance" string="Insurance Queue" groups="clearpath_discharge.group_clearpath_admin,base.group_system"
                        domain="[('state', 'in', ('flagged', 'verifying')), ('insurance_status', 'in', ('pending', 'flagged'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== Kanban dashboard (Phase 14) -->
    <record id="clearpath_discharge_view_kanban" model="ir.ui.view">
        <field name="name">clearpath.discharge.kanban</field>
        <field name="model">clearpath.discharge</field>
        <field name="arch" type="xml">
            <!-- Cards only move through the approvals (never by dragging): dragging would bypass the sign-offs. -->
            <kanban class="o_clearpath_kanban" default_group_by="state" default_order="id desc"
                    quick_create="false" group_create="false" group_edit="false" group_delete="false"
                    records_draggable="false">
                <field name="state"/>
                <field name="pharmacy_status"/>
                <field name="billing_status"/>
                <field name="insurance_status"/>
                <field name="pharmacy_conflict_count"/>
                <field name="unbilled_item_count"/>
                <field name="insurance_hold_count"/>
                <field name="patient_payment_status"/>
                <field name="coordinator_gate_locked"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_cp_kcard {{ record.state.raw_value == 'flagged' ? 'o_cp_kcard_flagged' : '' }} {{ record.state.raw_value == 'released' ? 'o_cp_kcard_done' : '' }}">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div class="o_cp_kmain">
                                    <div class="o_cp_kname"><field name="patient_id"/></div>
                                    <div class="o_cp_ksub">
                                        <i class="oi" data-icon="bed" title="Bed"/> Bed <field name="bed_number"/>
                                        <span class="o_cp_kdot">&#183;</span> <field name="patient_code"/>
                                    </div>
                                </div>
                                <span class="o_cp_krev" title="Revision"><i class="oi" data-icon="fork_right" title="Revision"/> Rev <field name="revision_id"/></span>
                            </div>
                            <div class="o_cp_kflags">
                                <span t-if="record.pharmacy_status.raw_value == 'flagged'" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_flagged"
                                      title="Pharmacy: unresolved flag">
                                    <i class="oi cp-beat-fade" data-icon="warning" title="Pharmacy flag"/> Pharmacy
                                    <t t-if="record.pharmacy_conflict_count.raw_value"><b>&#215;<t t-out="record.pharmacy_conflict_count.raw_value"/></b></t>
                                </span>
                                <span t-if="record.pharmacy_status.raw_value == 'pending' and record.state.raw_value != 'draft'" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system"
                                      class="o_cp_ktag o_cp_ktag_ready" title="Pharmacy: ready for review">
                                    <i class="oi" data-icon="schedule" title="Pharmacy ready"/> Pharmacy
                                </span>
                                <span t-if="record.pharmacy_status.raw_value == 'approved'" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_approved"
                                      title="Pharmacy: approved">
                                    <i class="oi" data-icon="check_circle" title="Pharmacy approved"/> Pharmacy
                                </span>
                                <span t-if="record.pharmacy_status.raw_value == 'stale'" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_stale"
                                      title="Pharmacy: stale, lock the revision again">
                                    <i class="oi" data-icon="refresh" title="Pharmacy stale"/> Pharmacy
                                </span>
                                <span t-if="record.billing_status.raw_value == 'flagged'" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_flagged"
                                      title="Billing: unresolved flag">
                                    <i class="oi cp-beat-fade" data-icon="warning" title="Billing flag"/> Billing
                                    <t t-if="record.unbilled_item_count.raw_value"><b>&#215;<t t-out="record.unbilled_item_count.raw_value"/></b></t>
                                </span>
                                <span t-if="record.billing_status.raw_value == 'pending' and record.state.raw_value != 'draft'" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system"
                                      class="o_cp_ktag o_cp_ktag_ready" title="Billing: ready for review">
                                    <i class="oi" data-icon="schedule" title="Billing ready"/> Billing
                                </span>
                                <span t-if="record.billing_status.raw_value == 'approved'" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_approved"
                                      title="Billing: approved">
                                    <i class="oi" data-icon="check_circle" title="Billing approved"/> Billing
                                </span>
                                <span t-if="record.billing_status.raw_value == 'stale'" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_stale"
                                      title="Billing: stale, lock the revision again">
                                    <i class="oi" data-icon="refresh" title="Billing stale"/> Billing
                                </span>
                                <span t-if="record.insurance_status.raw_value == 'flagged'" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_flagged"
                                      title="Insurance: unresolved flag">
                                    <i class="oi cp-beat-fade" data-icon="warning" title="Insurance flag"/> Insurance
                                    <t t-if="record.insurance_hold_count.raw_value"><b>&#215;<t t-out="record.insurance_hold_count.raw_value"/></b></t>
                                </span>
                                <span t-if="record.insurance_status.raw_value == 'pending' and record.state.raw_value != 'draft'" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system"
                                      class="o_cp_ktag o_cp_ktag_ready" title="Insurance: ready for review">
                                    <i class="oi" data-icon="schedule" title="Insurance ready"/> Insurance
                                </span>
                                <span t-if="record.insurance_status.raw_value == 'approved'" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_approved"
                                      title="Insurance: approved">
                                    <i class="oi" data-icon="check_circle" title="Insurance approved"/> Insurance
                                </span>
                                <span t-if="record.insurance_status.raw_value == 'stale'" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="o_cp_ktag o_cp_ktag_stale"
                                      title="Insurance: stale, lock the revision again">
                                    <i class="oi" data-icon="refresh" title="Insurance stale"/> Insurance
                                </span>
                                <span t-if="record.patient_payment_status.raw_value == 'paid'"
                                      class="o_cp_ktag o_cp_ktag_approved" title="Patient co-pay paid">
                                    <i class="oi" data-icon="payments" title="Co-pay"/> Co-pay paid
                                </span>
                            </div>
                            <div class="o_cp_kactions">
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.pharmacy_status.raw_value) and record.pharmacy_status.raw_value == 'flagged'" type="object" name="action_open_pharmacy_wizard"
                                        groups="clearpath_discharge.group_clearpath_pharmacist,base.group_system" class="btn btn-sm btn-danger">
                                    <i class="oi" data-icon="medical_services" title="Review Meds"/> Review Meds
                                </button>
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.pharmacy_status.raw_value) and record.pharmacy_status.raw_value == 'pending'" type="object" name="action_open_pharmacy_wizard"
                                        groups="clearpath_discharge.group_clearpath_pharmacist,base.group_system" class="btn btn-sm btn-outline-primary">
                                    <i class="oi" data-icon="medical_services" title="Review Meds"/> Review Meds
                                </button>
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.billing_status.raw_value) and record.billing_status.raw_value == 'flagged'" type="object" name="action_open_billing_wizard"
                                        groups="clearpath_discharge.group_clearpath_billing,base.group_system" class="btn btn-sm btn-danger">
                                    <i class="oi" data-icon="description" title="Review Billing"/> Review Billing
                                </button>
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.billing_status.raw_value) and record.billing_status.raw_value == 'pending'" type="object" name="action_open_billing_wizard"
                                        groups="clearpath_discharge.group_clearpath_billing,base.group_system" class="btn btn-sm btn-outline-primary">
                                    <i class="oi" data-icon="description" title="Review Billing"/> Review Billing
                                </button>
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.insurance_status.raw_value) and record.insurance_status.raw_value == 'flagged'" type="object" name="action_open_insurance_wizard"
                                        groups="clearpath_discharge.group_clearpath_admin,base.group_system" class="btn btn-sm btn-danger">
                                    <i class="oi" data-icon="security" title="Review Claim"/> Review Claim
                                </button>
                                <button t-if="['flagged', 'verifying'].includes(record.state.raw_value) and ['pending', 'flagged'].includes(record.insurance_status.raw_value) and record.insurance_status.raw_value == 'pending'" type="object" name="action_open_insurance_wizard"
                                        groups="clearpath_discharge.group_clearpath_admin,base.group_system" class="btn btn-sm btn-outline-primary">
                                    <i class="oi" data-icon="security" title="Review Claim"/> Review Claim
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="clearpath_discharge_view_form" model="ir.ui.view">
        <field name="name">clearpath.discharge.form</field>
        <field name="model">clearpath.discharge</field>
        <field name="arch" type="xml">
            <form string="Discharge" class="o_clearpath_discharge_form">
                <header>
                    <!-- PRIMARY workflow: 1 -> 2 -> release -->
                    <button name="action_generate_ai_draft" type="object" icon="flash_on" string="Generate AI Draft"
                            class="btn-primary" invisible="state != 'draft' or ai_draft_summary"
                            groups="clearpath_discharge.group_clearpath_doctor"/>
                    <button name="action_generate_ai_draft" type="object" icon="flash_on" string="Regenerate AI Draft"
                            class="btn-secondary" invisible="state != 'draft' or not ai_draft_summary"
                            groups="clearpath_discharge.group_clearpath_doctor"/>
                    <button name="action_lock_revision_and_verify" type="object" icon="lock"
                            string="Lock Revision &amp; Run Checks" class="btn-primary"
                            invisible="state != 'draft' or not ai_draft_summary"
                            groups="clearpath_discharge.group_clearpath_doctor"/>
                    <!-- Departmental sign-offs live in the smart-button pop-ups -->
                    <button name="action_generate_invoice" type="object" icon="description"
                            string="Generate Final Invoice" class="btn-primary"
                            invisible="invoice_id or (billing_status != 'approved' and state not in ('cleared', 'released'))"
                            groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_admin"/>
                    <button name="action_coordinator_release" type="object" icon="check_circle"
                            string="Release Discharge Packet" class="btn-success"
                            invisible="state != 'cleared' or coordinator_gate_locked"
                            groups="clearpath_discharge.group_clearpath_coordinator"/>
                    <!-- SECONDARY demo / utility buttons: small and muted -->
                    <button name="action_simulate_late_doctor_edit" type="object" icon="flash_on"
                            string="Simulate Late Doctor Edit" class="btn-light border btn-sm ms-3"
                            invisible="state in ('draft', 'released')"
                            groups="clearpath_discharge.group_clearpath_doctor"
                            confirm="Replace Amoxicillin with Azithromycin and bump the revision?"/>
                    <button name="action_reset_demo" type="object" icon="undo" string="Reset Demo"
                            class="btn-light border btn-sm" groups="base.group_system"
                            invisible="state == 'draft' and revision_id == 1 and not ai_draft_summary"
                            confirm="Reset this discharge to a clean Rev 1 draft?"/>
                    <button name="action_open_patient_tracker" type="object" class="btn-light border btn-sm"
                            string="&#128241; Live Patient Tracker"
                            title="Open the patient's phone view of this discharge in a new tab"/>
                    <button name="action_toggle_audit_log" type="object" class="btn-light border btn-sm"
                            string="&#128065;&#65039; Toggle Audit Log"/>
                    <button name="%(action_report_discharge_packet)d" type="action" icon="picture_as_pdf"
                            string="Download PDF Report" class="btn-light border btn-sm"
                            invisible="not ai_draft_summary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,flagged,cleared,released"
                           invisible="state == 'released'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="show_audit_log" invisible="1"/>
                        <field name="patient_payment_status" invisible="1"/>
                        <field name="pharmacy_status" invisible="1"/>
                        <field name="billing_status" invisible="1"/>
                        <field name="insurance_status" invisible="1"/>
                        <field name="pharmacy_conflict_count" invisible="1"/>
                        <field name="unbilled_item_count" invisible="1"/>
                        <field name="insurance_hold_count" invisible="1"/>
                        <field name="invoice_id" invisible="1"/>
                        <field name="top_alert_kind" invisible="1"/>
                        <button name="action_open_alerts_wizard" type="object" class="oe_stat_button o_cp_stat"
                                icon="warning" invisible="alert_count == 0">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                        <button name="action_open_pharmacy_wizard" type="object" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_flagged"
                                title="Pharmacy: open conflict(s), click to review" invisible="pharmacy_conflict_count == 0 or pharmacy_status in ('stale', 'approved')">
                            <div class="o_stat_info w-100">
                                <div class="d-flex flex-row align-items-center justify-content-center">
                                    <span class="o_stat_value fs-4 me-2"><field name="pharmacy_conflict_count"/></span>
                                    <i class="oi oi-2x text-danger cp-beat-fade" data-icon="warning"/>
                                </div>
                                <span class="o_stat_text fw-bold text-center d-block">Pharmacy</span>
                            </div>
                        </button>
                        <button name="action_open_pharmacy_wizard" type="object" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_pending"
                                title="Pharmacy: ready for review" invisible="state == 'draft' or pharmacy_status not in ('pending', 'flagged') or pharmacy_conflict_count != 0">
                            <i class="oi oi-2x text-warning o_button_icon" data-icon="medical_services"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Pharmacy</span>
                                <span class="o_stat_text">Ready to review</span></div>
                        </button>
                        <button name="action_open_pharmacy_wizard" type="object" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_approved"
                                title="Pharmacy: approved" invisible="pharmacy_status != 'approved'">
                            <i class="oi oi-2x text-success o_button_icon" data-icon="medical_services"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Pharmacy</span>
                                <span class="o_stat_text">Approved</span></div>
                        </button>
                        <button name="action_open_pharmacy_wizard" type="object" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_stale"
                                title="Pharmacy: stale, lock the revision again" invisible="pharmacy_status != 'stale'">
                            <i class="oi oi-2x text-secondary o_button_icon" data-icon="medical_services"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Pharmacy</span>
                                <span class="o_stat_text">Stale</span></div>
                        </button>
                        <button name="action_open_billing_wizard" type="object" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_flagged"
                                title="Billing: open conflict(s), click to review" invisible="unbilled_item_count == 0 or billing_status in ('stale', 'approved')">
                            <div class="o_stat_info w-100">
                                <div class="d-flex flex-row align-items-center justify-content-center">
                                    <span class="o_stat_value fs-4 me-2"><field name="unbilled_item_count"/></span>
                                    <i class="oi oi-2x text-danger cp-beat-fade" data-icon="warning"/>
                                </div>
                                <span class="o_stat_text fw-bold text-center d-block">Billing</span>
                            </div>
                        </button>
                        <button name="action_open_billing_wizard" type="object" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_pending"
                                title="Billing: ready for review" invisible="state == 'draft' or billing_status not in ('pending', 'flagged') or unbilled_item_count != 0">
                            <i class="oi oi-2x text-warning o_button_icon" data-icon="description"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Billing</span>
                                <span class="o_stat_text">Ready to review</span></div>
                        </button>
                        <button name="action_open_billing_wizard" type="object" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_approved"
                                title="Billing: approved" invisible="billing_status != 'approved'">
                            <i class="oi oi-2x text-success o_button_icon" data-icon="description"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Billing</span>
                                <span class="o_stat_text">Approved</span></div>
                        </button>
                        <button name="action_open_billing_wizard" type="object" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_stale"
                                title="Billing: stale, lock the revision again" invisible="billing_status != 'stale'">
                            <i class="oi oi-2x text-secondary o_button_icon" data-icon="description"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Billing</span>
                                <span class="o_stat_text">Stale</span></div>
                        </button>
                        <button name="action_open_insurance_wizard" type="object" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_flagged"
                                title="Insurance: open conflict(s), click to review" invisible="insurance_hold_count == 0 or insurance_status in ('stale', 'approved')">
                            <div class="o_stat_info w-100">
                                <div class="d-flex flex-row align-items-center justify-content-center">
                                    <span class="o_stat_value fs-4 me-2"><field name="insurance_hold_count"/></span>
                                    <i class="oi oi-2x text-danger cp-beat-fade" data-icon="warning"/>
                                </div>
                                <span class="o_stat_text fw-bold text-center d-block">Insurance</span>
                            </div>
                        </button>
                        <button name="action_open_insurance_wizard" type="object" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_pending"
                                title="Insurance: ready for review" invisible="state == 'draft' or insurance_status not in ('pending', 'flagged') or insurance_hold_count != 0">
                            <i class="oi oi-2x text-warning o_button_icon" data-icon="security"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Insurance</span>
                                <span class="o_stat_text">Ready to review</span></div>
                        </button>
                        <button name="action_open_insurance_wizard" type="object" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_approved"
                                title="Insurance: approved" invisible="insurance_status != 'approved'">
                            <i class="oi oi-2x text-success o_button_icon" data-icon="security"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Insurance</span>
                                <span class="o_stat_text">Approved</span></div>
                        </button>
                        <button name="action_open_insurance_wizard" type="object" groups="clearpath_discharge.group_clearpath_admin,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat o_cp_stat_stale"
                                title="Insurance: stale, lock the revision again" invisible="insurance_status != 'stale'">
                            <i class="oi oi-2x text-secondary o_button_icon" data-icon="security"/>
                            <div class="o_stat_info"><span class="o_stat_value fs-6 fw-bold">Insurance</span>
                                <span class="o_stat_text">Stale</span></div>
                        </button>
                        <button name="action_view_invoice" type="object" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_coordinator,base.group_system" class="oe_stat_button o_cp_stat"
                                icon="payments" invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="invoice_label"/></span>
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Released" bg_color="text-bg-success"
                            invisible="state != 'released'"/>
                    <widget name="web_ribbon" title="Allergy Hold" bg_color="text-bg-danger" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system"
                            invisible="pharmacy_status != 'flagged' or state == 'released'"/>
                    <widget name="web_ribbon" title="Cleared" bg_color="text-bg-success"
                            invisible="coordinator_gate_locked or state == 'released'"/>

                    <div class="alert alert-danger d-flex align-items-center o_cp_strip" role="alert"
                         invisible="top_alert_kind != 'pharmacy'">
                        <i class="oi oi-2x cp-pulse me-3" data-icon="warning"/>
                        <h3 class="mb-0"><strong>CRITICAL:</strong> <field name="top_alert_title" class="d-inline"/></h3>
                        <button name="action_open_alerts_wizard" type="object" class="btn btn-link ms-auto"
                                string="Details" icon="notifications"/>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center o_cp_strip" role="alert"
                         invisible="top_alert_kind != 'billing'">
                        <i class="oi oi-2x cp-shake me-3" data-icon="error"/>
                        <h3 class="mb-0"><strong>BILLING:</strong> <field name="top_alert_title" class="d-inline"/></h3>
                        <button name="action_open_alerts_wizard" type="object" class="btn btn-link ms-auto"
                                string="Details" icon="notifications"/>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center o_cp_strip" role="alert"
                         invisible="top_alert_kind != 'insurance'">
                        <i class="oi oi-2x cp-beat me-3" data-icon="pause_circle"/>
                        <h3 class="mb-0"><strong>ON HOLD:</strong> <field name="top_alert_title" class="d-inline"/></h3>
                        <button name="action_open_alerts_wizard" type="object" class="btn btn-link ms-auto"
                                string="Details" icon="notifications"/>
                    </div>

                    <div class="oe_title">
                        <h1 class="d-flex align-items-center"><i class="oi text-primary me-2" data-icon="stethoscope"/><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Patient & governance banner -->
                    <div class="o_cp_banner d-flex flex-wrap align-items-center justify-content-between px-4 py-3 mb-4">
                        <span class="o_cp_shine"/>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <span class="d-inline-flex align-items-center">
                                <i class="oi text-primary me-1" data-icon="person"/><span class="text-muted me-1">Patient:</span>
                                <field name="patient_id" readonly="id" class="fw-bold d-inline" options="{'no_open': True}"/>
                            </span>
                            <span class="d-inline-flex align-items-center">
                                <i class="oi text-primary me-1" data-icon="bed"/><span class="text-muted me-1">Bed:</span>
                                <field name="bed_number" readonly="1" class="fw-bold d-inline"/>
                            </span>
                            <span class="d-inline-flex align-items-center" invisible="not invoice_id">
                                <i class="oi text-primary me-1" data-icon="payments"/><span class="text-muted me-1">Invoice:</span>
                                <field name="invoice_label" class="fw-bold d-inline"/>
                            </span>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="o_cp_pill">
                                <i class="oi me-1" data-icon="fork_right"/>Rev <field name="revision_id" class="d-inline"/>
                            </span>
                            <span class="o_cp_pill font-monospace" invisible="not revision_hash"
                                  title="Snapshot hash (the full SHA-256 is in the Audit Packet tab)">
                                <i class="oi me-1" data-icon="tag"/><field name="short_revision_hash" class="d-inline"/>
                            </span>
                            <span class="o_cp_pill" invisible="patient_payment_status == 'paid'"
                                  title="Patient co-pay, paid from the live tracker page">
                                <i class="oi me-1" data-icon="payments"/>Co-Pay: Unpaid
                            </span>
                            <span class="badge rounded-pill text-bg-success px-3 py-2" invisible="patient_payment_status != 'paid'"
                                  title="Patient co-pay, paid from the live tracker page">
                                <i class="oi me-1" data-icon="payments"/>Co-Pay: Paid
                            </span>
                            <span class="badge rounded-pill text-bg-danger px-3 py-2" invisible="not coordinator_gate_locked">
                                <i class="oi me-1" data-icon="lock"/>Gate Locked
                            </span>
                            <span class="badge rounded-pill text-bg-success px-3 py-2" invisible="coordinator_gate_locked">
                                <i class="oi me-1" data-icon="lock_open"/>Gate Unlocked
                            </span>
                        </div>
                        <div class="w-100 mt-2 o_cp_hist_row" invisible="not patient_history_html">
                            <span class="o_cp_hist_label"><i class="oi" data-icon="history" title="History"/> Past history</span>
                            <field name="patient_history_html" nolabel="1" class="d-inline"/>
                        </div>
                    </div>

                    <!-- Section 1: multimodal bedside inputs -->
                    <div class="o_cp_panel p-3 mb-4">
                        <div class="o_cp_panel_title mb-3">
                            <i class="oi me-1" data-icon="mic"/> Multimodal Bedside Inputs
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="o_cp_subpanel h-100 p-3">
                                    <h5 class="fw-bold mb-3 d-flex align-items-center"><i class="oi o_cp_chip o_cp_chip_red me-2" data-icon="mic"/>Doctor Voice Dictation</h5>
                                    <div invisible="state != 'draft'"
                                         groups="clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_nurse">
                                        <field name="voice_note_audio" filename="voice_note_filename" widget="wav_recorder" nolabel="1"/>
                                        <field name="voice_note_filename" invisible="1"/>
                                        <button name="action_transcribe_voice_and_draft" type="object"
                                                string="&#127897;&#65039; Transcribe Voice &amp; Draft" class="btn-light border mt-2"
                                                invisible="not voice_note_audio"
                                                groups="clearpath_discharge.group_clearpath_doctor"/>
                                    </div>
                                    <div class="mt-3">
                                        <label for="raw_handoff_note" string="Handoff Note"
                                               class="fw-bold text-muted small text-uppercase d-block mb-1"/>
                                        <field name="raw_handoff_note" nolabel="1" readonly="state == 'released'"
                                               placeholder="Dictate a voice note or type the clinical rounds summary here..."/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="o_cp_subpanel h-100 p-3 d-flex flex-column justify-content-between">
                                    <div>
                                        <h5 class="fw-bold mb-3 d-flex align-items-center"><i class="oi o_cp_chip me-2" data-icon="photo_camera"/>Nurse Supply Sheet Checklist</h5>
                                        <div class="o_cp_drop p-3 text-center my-2">
                                            <field name="nurse_checklist_image" widget="image" nolabel="1"
                                                   options="{'size': [0, 140]}" readonly="state != 'draft'"/>
                                        </div>
                                        <button name="action_scan_nurse_checklist" type="object"
                                                string="&#128247; Scan Nurse Supply Sheet" class="btn-light border"
                                                invisible="not nurse_checklist_image or state != 'draft'"
                                                groups="clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_nurse"/>
                                    </div>
                                    <p class="text-muted small mb-0 mt-2">
                                        Scan a camera image or upload the bedside supply sheet to auto-fill the surgical usage log.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: structured AI discharge summary -->
                    <div class="o_cp_panel o_cp_panel_accent p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="o_cp_panel_title">Structured AI Discharge Summary</div>
                                <h4 class="fw-bold mb-0 mt-2 text-dark d-flex align-items-center"><i class="oi o_cp_chip me-2" data-icon="flash_on"/>Discharge Summary</h4>
                            </div>
                            <a role="button" class="btn btn-light border btn-sm" data-bs-toggle="collapse"
                               data-bs-target="#cp_edit_summary" invisible="state == 'released'">
                                <i class="oi" data-icon="edit"/> Edit summary text
                            </a>
                        </div>
                        <div class="o_cp_summary_body" invisible="not ai_draft_summary">
                            <field name="ai_draft_summary_html" nolabel="1"/>
                        </div>
                        <p class="text-muted mb-0" invisible="ai_draft_summary">
                            Click Generate AI Draft (or Transcribe Voice) to create the summary.
                        </p>
                        <div class="collapse mt-3" id="cp_edit_summary">
                            <field name="ai_draft_summary" nolabel="1" readonly="state == 'released'"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Clinical Draft" name="clinical">
                            <group>
                                <field name="review_prompts" readonly="1"/>
                            </group>
                            <field name="medication_line_ids" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,clearpath_discharge.group_clearpath_admin,base.group_system" readonly="state == 'released'">
                                <list editable="bottom" decoration-danger="is_flagged">
                                    <field name="drug_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="conflict_reason" groups="clearpath_discharge.group_clearpath_pharmacist,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,base.group_system"/>
                                    <field name="is_flagged" column_invisible="True"/>
                                </list>
                            </field>
                            <separator string="Surgical Supplies Used" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,clearpath_discharge.group_clearpath_nurse,base.group_system"/>
                            <field name="supply_line_ids" groups="clearpath_discharge.group_clearpath_billing,clearpath_discharge.group_clearpath_doctor,clearpath_discharge.group_clearpath_coordinator,clearpath_discharge.group_clearpath_nurse,base.group_system" readonly="state == 'released'">
                                <list editable="bottom">
                                    <field name="item_name"/>
                                    <field name="surgical_qty_used"/>
                                </list>
                            </field>
                        </page>

                        <page string="Patient Tracker &amp; SMS" name="patient_tracker">
                            <group>
                                <group string="Live Tracker">
                                    <field name="patient_tracker_url" widget="url" readonly="1"/>
                                    <field name="last_sms_status"/>
                                </group>
                                <group string="Co-Pay">
                                    <field name="copay_amount" readonly="patient_payment_status == 'paid' or state == 'released'"/>
                                    <field name="patient_payment_status" readonly="1" widget="badge"
                                           decoration-success="patient_payment_status == 'paid'"
                                           decoration-warning="patient_payment_status == 'unpaid'"/>
                                    <field name="patient_paid_on" invisible="not patient_paid_on"/>
                                </group>
                            </group>
                            <p class="text-muted small">
                                The patient gets this link by SMS when the doctor locks the revision. It needs no login:
                                anyone holding the link can see the progress and pay the co-pay, so share it only with the patient.
                            </p>
                        </page>
                        <page string="Audit Packet" name="audit">
                            <group>
                                <field name="revision_hash" readonly="1"/>
                            </group>
                            <!-- Readable packet; the raw JSON is collapsed at its bottom -->
                            <field name="audit_report_html" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter invisible="not show_audit_log"/>
            </form>
        </field>
    </record>
</odoo>
