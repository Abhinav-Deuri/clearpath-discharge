<odoo>
    <record id="clearpath_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clearpath.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="clearpath_patient_view_list" model="ir.ui.view">
        <field name="name">clearpath.patient.list</field>
        <field name="model">clearpath.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="patient_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="bed_number"/>
            </list>
        </field>
    </record>

    <record id="clearpath_patient_view_form" model="ir.ui.view">
        <field name="name">clearpath.patient.form</field>
        <field name="model">clearpath.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_code"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="bed_number"/>
                            <field name="insurance_provider"/>
                            <field name="policy_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allergies" name="allergies">
                            <field name="allergy_ids">
                                <list editable="bottom">
                                    <field name="allergen"/>
                                    <field name="reaction"/>
                                    <field name="criticality"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discharges" name="discharges">
                            <field name="discharge_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="revision_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
