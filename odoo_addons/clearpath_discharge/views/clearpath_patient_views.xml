<odoo>
    <record id="clearpath_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clearpath.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="clearpath_patient_view_list" model="ir.ui.view">
        <field name="name">clearpath.patient.list</field>
        <field name="model">clearpath.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="patient_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="bed_number"/>
            </list>
        </field>
    </record>

    <record id="clearpath_patient_view_form" model="ir.ui.view">
        <field name="name">clearpath.patient.form</field>
        <field name="model">clearpath.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Patient full name"/></h1>
                    </div>
                    <group string="Contact Details (saved to Odoo Contacts)">
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="street" placeholder="Street"/>
                            <field name="city" placeholder="City"/>
                            <field name="zip" placeholder="ZIP"/>
                            <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Clinical Admission Details">
                        <group>
                            <field name="patient_code"/>
                            <field name="bed_number"/>
                        </group>
                        <group>
                            <field name="insurance_provider"/>
                            <field name="policy_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allergies" name="allergies">
                            <field name="allergy_ids">
                                <list editable="bottom">
                                    <field name="allergen"/>
                                    <field name="reaction"/>
                                    <field name="criticality"/>
                                </list>
                            </field>
                        </page>
                        <page string="Past Medical &amp; Surgical History" name="history">
                            <field name="history_ids">
                                <list editable="bottom" decoration-muted="status == 'resolved'">
                                    <field name="condition_name"/>
                                    <field name="history_type"/>
                                    <field name="diagnosis_date"/>
                                    <field name="status" widget="badge"
                                           decoration-warning="status == 'active'"
                                           decoration-success="status == 'resolved'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discharges" name="discharges">
                            <field name="discharge_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="revision_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
